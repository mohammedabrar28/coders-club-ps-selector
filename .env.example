# Copy this file to ".env" and fill it in. ".env" is git-ignored. NEVER commit it.
# These values are used only by the scripts in /scripts, run on YOUR computer.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SECRET. Supabase → Project Settings → API → service_role key.
# Never paste this into anything inside /public. Never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Public key (publishable / anon). Only needed for `npm run verify`.
SUPABASE_PUBLISHABLE_KEY=

# Administrator account
ADMIN_USERNAME=Coderscrew
# Initial prototype password. CHANGE THIS before the hackathon, then run:
#   npm run set-admin-password
ADMIN_PASSWORD=Coderscrew2026

# These two MUST match public/config.js
EMAIL_DOMAIN=coders-club.example
PASSWORD_PREFIX=csps::
